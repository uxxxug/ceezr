# الغرض: صورة العامل — تشغيل apps/workers/src/index.ts وحده.
# ملاحظات: انظر التعليل الكامل في Dockerfile.gateway. الفرق أنّ العامل لا يستورد
#   من apps/gateway ولا من apps/admin-dashboard (مُتحقَّق منه بتتبّع الاستيرادات)،
#   فيُنسَخ apps/workers وحده. وحارس `bun build` هو ما يجعل هذا الادّعاء
#   قابلاً للفشل بصوتٍ عالٍ إن استورد العامل يوماً من خارج نطاقه.
FROM oven/bun:1.3.14 AS base
WORKDIR /app

COPY package.json bun.lock tsconfig.json ./
RUN bun install --frozen-lockfile

COPY packages ./packages
COPY apps/workers ./apps/workers

RUN bun build apps/workers/src/index.ts --target=bun --outfile=/tmp/worker-resolve-check.js \
  && rm -f /tmp/worker-resolve-check.js

ENV NODE_ENV=production
CMD ["bun", "run", "apps/workers/src/index.ts"]

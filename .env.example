# ===== بيئة التشغيل =====
NODE_ENV=development
PORT=3000

# ===== Supabase (PostgreSQL + RLS) =====
# رابط اتصال Postgres المباشر (Supabase → Settings → Database → Connection string)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Upstash Redis (تخزين مؤقت + قفل موزّع) =====
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== بوتات تيليجرام (grammY) =====
DRIVER_BOT_TOKEN=
RIDER_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ===== أول مسؤول (bootstrap) =====
# معرّف تيليجرام الرقمي لأول مسؤول. إلزامي: بدونه لا مسار لتعيين مسؤول
# في نظام كل صلاحياته في القاعدة (انظر ADR-0008).
BOOTSTRAP_ADMIN_TELEGRAM_ID=

# ===== الترجمة الآلية (اختيارية) =====
# اختيارية عن قصد وليست في REQUIRED_ENV_KEYS: النظام يعمل كاملاً بدونها،
# و`none` قيمة صالحة صريحة تعني «شغّل بلا ترجمة» لا عطلاً (انظر ADR-0010).
# القيم المدعومة: none | deepl | google | google-web | mymemory
# مفتاح المزوّد مطلوب لـ deepl و google فقط، وgoogle-web للتطوير لا للإنتاج.
TRANSLATION_PROVIDER=none
TRANSLATION_API_KEY=
TRANSLATION_CONTACT_EMAIL=

# ===== مخزن جلسات الحوار =====
# memory: خريطة في ذاكرة العملية — تعمل كاملة لنسخة واحدة فقط.
# redis: على Upstash بنفس المتغيّرين أعلاه — إلزامي عند تشغيل أكثر من نسخة،
#        لأن رسالتين متتاليتين لنفس المستخدم قد تصلان نسختين مختلفتين
#        فتُقرأ حالة الحوار من ذاكرة لا تحويها (انظر ADR-0011).
# اختياري وليس في REQUIRED_ENV_KEYS، والافتراضي memory.
SESSION_STORE=memory

# ===== المهامّ الدورية داخل عملية البوابة =====
# false: المهامّ مسؤولية خدمة waslah-worker المستقلّة (الأنقى: سجلّ ومقياس منفصلان).
# true:  يُقلع نفس المجدول داخل البوابة — إلزامي حين لا توجد خدمة عامل مستقلّة،
#        وإلّا لم يُرسَل إشعار «لا يوجد سائق» ولا تُصعّد طلبة ولا تنتهي مهلة عرض.
# تشغيلهما معاً آمن: القفل الموزَّع يمنع التنفيذ المزدوج. راجع docs/render-deployment-vars.md
RUN_WORKER_IN_GATEWAY=false

# ملاحظة حاكمة: ممنوع وضع أي سعر أو مهلة أو وزن مطابقة هنا.
# كل قيمة تجارية قابلة للتغيير مكانها جدول platform_settings في قاعدة البيانات.

# ============================================================
# بيئة التشغيل
# ============================================================
NODE_ENV=development
PORT=3000

# ============================================================
# Supabase (PostgreSQL + RLS)
# ============================================================
# رابط اتصال Postgres المباشر (Supabase → Settings → Database → Connection string)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Upstash Redis (تخزين مؤقت + قفل موزّع)
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# للاستخدام المباشر (non-REST) — اتركه فارغاً إن استخدمت REST أعلاه
REDIS_URL=

# ============================================================
# بوتات تيليجرام (grammY)
# ============================================================
DRIVER_BOT_TOKEN=
RIDER_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ============================================================
# أول مسؤول (bootstrap)
# ============================================================
# معرّف تيليجرام الرقمي لأول مسؤول. إلزامي: بدونه لا مسار لتعيين مسؤول
BOOTSTRAP_ADMIN_TELEGRAM_ID=

# ============================================================
# الترجمة الآلية (اختيارية)
# ============================================================
# القيم المدعومة: none | deepl | google | google-web | mymemory
TRANSLATION_PROVIDER=none
TRANSLATION_API_KEY=
TRANSLATION_CONTACT_EMAIL=

# ============================================================
# مخزن جلسات الحوار
# ============================================================
# memory: خريطة في ذاكرة العملية — تعمل كاملة لنسخة واحدة فقط.
# redis: على Upstash — إلزامي عند تشغيل أكثر من نسخة.
SESSION_STORE=memory

# ============================================================
# المهامّ الدورية داخل عملية البوابة
# ============================================================
# true: يُقلع نفس المجدول داخل البوابة — إلزامي حين لا توجد خدمة عامل مستقلّة
RUN_WORKER_IN_GATEWAY=false

# ============================================================
# البند 7: النسخ الاحتياطي اليومي إلى Google Drive
# ============================================================
# حساب خدمة Google بصيغة JSON كاملة (google-service-account.json)
# انسخ محتوى JSON بالكامل هنا — يُقرأ في وقت التشغيل
GOOGLE_SERVICE_ACCOUNT_JSON=
# معرّف مجلد Google Drive الذي تُرفع إليه النسخ الاحتياطية
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
# عدد النسخ الاحتياطية المحتفظ بها (الأقدم يُحذف)
BACKUP_RETENTION_COUNT=7

# ============================================================
# البند 8: طبقة الدفع (اشتراك السائق الشهري فقط)
# ============================================================
# مزوّد الدفع: moyasar (مدمج فعلاً) | manual (تفعيل يدوي عبر الدعم)
# اتركه فارغاً لتعطيل مسار الدفع كلّه — لا يوقف الإقلاع ولا الرحلات
PAYMENT_PROVIDER=
# مفتاح Moyasar السرّي (sk_…) — يُستخدم كاسم مستخدم في Basic auth بكلمة سرٍّ فارغة
MOYASAR_SECRET_KEY=
# السرّ الذي يُثبِته Moyasar داخل جسم الويبهوك (secret_token). لا ترويسة مخترعة:
# لا يُقرأ PAYMENT_WEBHOOK_SECRET بعد اليوم، ولا يُؤخذ مبلغٌ ولا حالةٌ من الحمولة
MOYASAR_WEBHOOK_SECRET=
# صفحة النتيجة التي يُعاد إليها الدافع بعد الدفع (عامّة لا سرّ فيها)
MOYASAR_CALLBACK_URL=
MOYASAR_SUCCESS_URL=
MOYASAR_BACK_URL=
# البيئة: sandbox للتجربة، production للإنتاج
PAYMENT_ENVIRONMENT=sandbox
# تفعيل تدفّق اشتراك السائق الشهري (true/false)
ENABLE_DRIVER_SUBSCRIPTION=false

# ============================================================
# البند 9: الخرائط والتتبّع اللحظي
# ============================================================

# --- محرّك عرض الخرائط ---
# القيم المدعومة فعلاً: none | maplibre
# قيمةٌ غير هاتين تمنع الإقلاع (المرحلة ١٠): كانت تُقبل بصمتٍ فتُنتج لوحةً بلا خريطة
# بلا سبب. و google لم يُنفَّذ؛ فإدراجُه هنا كان وعداً لا يقابله كود.
MAP_PROVIDER=none

# --- نمط الخريطة (Style JSON) ---
# رابط ملف نمطٍ كامل بصيغة MapLibre Style Spec — لا قالب بلاطات {z}/{x}/{y}.
# المحرّك يقرأ النمط، والنمط هو الذي يُعرّف مصادر البلاطات وطبقاتها.
# يجب أن يكون https: نمطٌ على http يُحجب كمحتوىً مختلط فتظهر خريطةٌ فارغة بلا خطأ.
# مثال MapTiler: https://api.maptiler.com/maps/streets/style.json
# فارغاً = لا خريطة، والبقيّة تعمل (لا يمنع الإقلاع).
MAP_STYLE_URL=

# --- مفتاح البلاطات العلني ---
# يُضاف إلى رابط النمط كـ ?key=… عند الطلب. علنيٌّ بطبعه: يصل المتصفّح فيُقرأ من
# مصدر الصفحة. فليكن مفتاحاً مُقيَّداً بالنطاق (Domain-restricted) وبحصّةٍ محدودة،
# ولا يُستعمل هنا مفتاحٌ يملك صلاحياتِ إدارةِ حساب.
# ممنوع وضعُه هنا **و** في رابط النمط معاً: مصدران للحقيقة، والإقلاع يُرفض.
MAP_TILES_PUBLIC_KEY=

# --- بصمة سلامة MapLibre (SRI) ---
# بصمةُ ملفّ maplibre-gl.js للإصدار المثبَّت في الكود (لا @latest).
# فارغةً = لا تُصيَّر الخريطة، ويُعرض السببُ في الصفحة نصّاً مقروءاً — مقصود:
# تحميلُ نصٍّ من شبكة توصيلٍ بلا بصمةٍ يعني الثقةَ العمياء بها في لوحة الإدارة.
# تُحسب بأمرٍ واحد (يُنظر docs/adr/0019):
#   curl -sL https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js \
#     | openssl dgst -sha384 -binary | openssl base64 -A
# ثم تُوضع هنا بالصيغة: sha384-<الناتج>
MAPLIBRE_SRI=

# --- محرّك التوجيه (Routing) — المرحلة ١٥ ---
# القيم المدعومة فعلاً: none | osrm
# ‏«فعلاً» قيدٌ مقصود: هذا الملف كان يعرض `valhalla` و`google` ولا وجود لهما في
# الكود، و`ROUTING_PROVIDER` نفسه لم يكن يُقرأ في الضبط قط — فمن ضبطه ظنّ أنّه
# شغّل التوجيه وهو معطَّل. والقيمةُ المجهولة الآن تمنع الإقلاع بخطأٍ مبيَّن.
#
# الافتراض `none`: زمن الوصول لا يُعرَض إطلاقاً، والمسافة تبقى بالخطّ المستقيم
# موسومةً بذلك. لا يُختلَق تقديرٌ من معامل تصحيح: نسبةُ الالتفاف المقيسة في جدّة
# على ١٥ زوجاً حقيقياً تراوحت بين ١.١٢ و٢.٨٣، فمعامل المتوسط يُخطئ حتّى −٤٦٪.
ROUTING_PROVIDER=none
# رابط خادم OSRM — **مطلوبٌ** عند ROUTING_PROVIDER=osrm، ويجب أن يبدأ بـ http/https
#
# ⚠️ ‏router.project-osrm.org خادمٌ تجريبيّ عامّ: سياسةُ استخدامه تمنع الإنتاج،
# ولا يقدّم ضماناً على الجهوزيّة ولا على المهلة. استعمله للتجربة المحليّة فقط.
# للإنتاج: استضف OSRM بنفسك على خريطة الجزيرة العربيّة.
#
# ملاحظة تشغيليّة مقيسة: مهلةُ المزوّد ٣ ثوانٍ **إجماليّة** للمحاولتين، وتُضاف
# إلى كل بطاقة رحلة وكل ردٍّ على قبول عرض. لا يوجد قاطعُ دائرة بعد (R-55).
# مثال: http://osrm.internal:5000
OSRM_BASE_URL=
# مفتاح Google Maps API (إن استخدمت Google للتوجيه أو الخرائط) — اختياري
GOOGLE_MAPS_API_KEY=

# --- التتبّع اللحظي ---
# معدّل تحديث GPS بالثواني أثناء القيادة (2-5 موصى به)
TRACKING_GPS_INTERVAL_SECONDS=3
# معدّل تحديث GPS أثناء الوقوف بالثواني (15-30 موصى به)
TRACKING_GPS_IDLE_INTERVAL_SECONDS=20
# الحد الأدنى للانزياف بالمتر قبل إرسال تحديث موقع (10-30 موصى به)
TRACKING_MIN_DISTANCE_METERS=15
# الحد الأقصى للسرعة المعقولة كم/سا — ما فوقه يُعلَّم كمشبوه (منع التلاعب)
TRACKING_MAX_REASONABLE_SPEED_KMH=200
# مسافة الانتقال اللحظي المسموحة — ما فوقها يُرفض الموقع (منع teleportation)
TRACKING_TELEPORT_THRESHOLD_METERS=5000

# --- الأمان والتلاعب ---
# تفعيل التحقّق من صحة موقع GPS (دقة، زمن، سرعة، انتقال)
TRACKING_VALIDATE_LOCATIONS=true

# ملاحظة حاكمة: ممنوع وضع أي سعر أو مهلة أو وزن مطابقة هنا.
# كل قيمة تجارية قابلة للتغيير مكانها جدول platform_settings في قاعدة البيانات.

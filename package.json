{
  "name": "waslah",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "ci": "bun run typecheck && bun run test",
    "dev": "bun run --watch apps/gateway/src/index.ts",
    "start": "bun run apps/gateway/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "grammy": "^1.45.1",
    "hono": "^4.13.0"
  }
}

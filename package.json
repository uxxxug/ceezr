{
  "name": "waslah",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "ci": "bun run typecheck && bun run test",
    "dev": "bun run --watch apps/gateway/src/index.ts",
    "start": "bun run apps/gateway/src/index.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun test tests/e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "grammy": "^1.45.1",
    "hono": "^4.13.0",
    "postgres": "^3.4.9"
  }
}
